# Copie este archivo como ".env" para personalizar (opcional). El MVP NO necesita secretos.
# Si algún día se agregan claves, van en ".env" (ignorado por git) o en los "Secrets" de GitHub, jamás en el código.
APP_VERSION=1.0.0
PUBLIC_PORT=8080
STATS_PORT=8404
REPLICAS=2
# Respaldo automático (perfil "auto"): cada cuántos segundos y cuántos respaldos conservar
BACKUP_INTERVAL_SECONDS=300
BACKUP_RETENTION=10
